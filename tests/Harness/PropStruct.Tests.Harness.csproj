    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ILGPU" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tail coverage's sensitivity sweeps (this node's BOOT.md, ## Tail coverage (2026-09-18), step 4) need
         FixedWidthPrefixLength to build their own mutated candidates without a second copy of the formula. -->
