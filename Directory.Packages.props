<Project>

  <!-- Every package version of the tree is pinned here (root BOOT.md, Dependencies), matching APThermo's versions. -->
  <ItemGroup>
    <!-- Exactly 1.5.3: Execution asserts the ILGPU assembly version 1.5.3.0, so the package dependency is the exact range. -->
    <PackageVersion Include="ILGPU" Version="[1.5.3]" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
